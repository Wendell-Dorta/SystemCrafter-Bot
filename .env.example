# =======================================================
# SystemCrafter AI - Global Environment Variables
# =======================================================

# Google Gemini API Key (Obtain from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# AI Model Selection
GEMINI_MODEL=gemini-3.5-flash-lite

# Backend & Server Settings
PORT=8080
ENVIRONMENT=production

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://127.0.0.1:3000,http://localhost

# Frontend API URL configuration
NEXT_PUBLIC_API_URL=http://localhost:8080
INTERNAL_BACKEND_URL=http://backend:8080
