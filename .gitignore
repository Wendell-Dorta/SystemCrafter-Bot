# ==========================================
# SystemCrafter AI - Global Git Ignore
# ==========================================

# Environment variables and credentials
.env
.env.*
*.env
!*.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.id_rsa
*.secret

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDEs and Editors
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Go Binaries and Test Artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.*
*.coverprofile
profile.cov
vendor/
bin/
go.work
go.work.sum

# Backend Storage & Workspaces Runtime
backend/storage/workspaces/*
!backend/storage/workspaces/.gitkeep
storage/workspaces/*
!storage/workspaces/.gitkeep
backend/tests/unit/storage/workspaces/*
!backend/tests/unit/storage/workspaces/.gitkeep

# Node.js and Next.js
node_modules/
.next/
out/
build/
dist/
.turbo/
.vercel/
*.tsbuildinfo
next-env.d.ts

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.pnpm-store/

# Temporary files and scratch
*.tmp
*.temp
scratch/
.tempmediaStorage/

# Docker Local Overrides
docker-compose.override.yml
