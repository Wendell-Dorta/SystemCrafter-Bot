# ==========================================
# Frontend Next.js .gitignore
# ==========================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js & Turbopack build outputs
/.next/
/out/
/build/
/dist/
.turbo/
.vercel/
*.tsbuildinfo
next-env.d.ts

# Testing and coverage
/coverage/

# Environment files
.env
.env.*
*.env
!*.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS & IDE
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/
